---

<Layout title="Photo Highlights & Invicta 98.9 FM News Coverage of the 2024 ECWA Scholars Summit/Conference. | ECWA Society for Scholars">
  <Header />
  <div class="plus-jakarta-sans-normal">
    <div class="bg-[#faf5ee] py-10">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="text-xs space-x-2">
          <a href="/" class="text-[#06005A] hover:opacity-60">
            Home
          </a>
          <span>/</span>
          <a href="/news-and-events" class="text-[#06005A] hover:opacity-60">
            News & Events
          </a>
          <span>/</span>
          <span class="text-black">Read</span>
        </div>
        <h2 class="font-bold text-xl lg:text-3xl mt-2 libre-baskerville-bold uppercase">
          Photo Highlights & Invicta 98.9 FM News Coverage of the 2024 ECWA
          Scholars Summit/Conference.
        </h2>
      </div>
    </div>

    <section class="py-20">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-20">
          <div>
            <div class="w-full bg-cyan-800 h-0.5"></div>
          </div>
          <div class="news col-span-2 space-y-6 text-base text-slate-600">
            <p>News recap of ECWA Scholars Summit Conference 2024 on radio:</p>
            <p>
              <audio controls="" class="w-full">
                <source src="horse.ogg" type="audio/ogg" />
                <source
                  type="audio/mpeg"
                  src="/audio/invicta-fm-on-ECWA-scholars-conference-2024.mp3"
                />
                Your browser does not support the audio element.
              </audio>
            </p>
            <p>Pictures from the 2024 ECWA Scholars Summit Conference:</p>
            {conferenceImages.map((image, index) => (
              <p>
                <Image
                  src={image}
                  alt={`2024 Annual Conference of ECWA Society for Scholars — photo ${index + 1}`}
                  class="w-full"
                />
              </p>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!--  -->
  </div>
  <Footer />
</Layout>
