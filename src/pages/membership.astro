---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import membership from "../assets/membership.jpeg";
---

<Layout title="Membership | ECWA Society for Scholars">
  <Header />
  <div class="plus-jakarta-sans-normal">
    <div class="bg-[#faf5ee] py-5 lg:py-10">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="text-xs space-x-2">
          <a href="/" class="text-[#06005A] hover:opacity-60">
            Home
          </a>
          <span>/</span>
          <span class="text-black">Membership</span>
        </div>
        <h2 class="font-bold text-xl lg:text-3xl mt-2 libre-baskerville-bold">
          ESS Membership
        </h2>
      </div>
    </div>

    <section>
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="text-lg py-10 lg:py-20 text-slate-600 lg:w-8/12">
          <h2 class="font-bold">A network for scholarship and service.</h2>
          <div>
            Build meaningful academic connections while supporting research,
            collaboration, and the mission of ECWA.
          </div>
        </div>
      </div>
    </section>

    <!-- Intro -->
    <section class="">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="py-10 lg:py-20 border-y border-cyan-600 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <p class="text-base lg:text-lg font-bold tracking-wider text-[#06005A]">
              Join the community
            </p>
            <h2 class="lg:mt-3 text-xl lg:text-3xl font-bold text-slate-900 sm:text-4xl">
              Become a Member of ESS
            </h2>
            <p class="mt-6 text-base lg:text-lg leading-8 text-slate-600">
              Membership of the ECWA Society for Scholars is open to
              distinguished academics, researchers, and scholars who identify
              with the vision and mission of the Society. ESS provides a
              platform for members to connect, collaborate, conduct research,
              and contribute to the growth of ECWA and society.
            </p>
          </div>

          <div>
            <Image
              src={membership}
              alt="A network for scholarship and service"
              class="h-full w-full rounded object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="bg-white py-10 sm:py-20">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="max-w-2xl">
          <p class="text-base lg:text-lg font-bold tracking-wider text-[#06005A]">
            The ESS community
          </p>
          <h2 class="mt-3 text-xl lg:text-3xl font-bold tracking-tight text-slate-900">
            Why Join ESS?
          </h2>
          <p class="lg:mt-4 leading-7 text-slate-600">
            As a member, you will have opportunities to:
          </p>
        </div>

        <div class="mt-5 lg:mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 text-white">
          <div
            class="p-6 bg-[#042F3A] text-base leading-relaxed text-white"
            style="background-image:
      repeating-linear-gradient(0deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      repeating-linear-gradient(90deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      radial-gradient(at 20% 20%, rgba(6,182,212,0.35) 0, transparent 50%),
      radial-gradient(at 80% 15%, rgba(34,211,238,0.25) 0, transparent 45%),
      radial-gradient(at 70% 85%, rgba(8,145,178,0.3) 0, transparent 50%),
      radial-gradient(at 10% 90%, rgba(103,232,249,0.2) 0, transparent 45%);"
          >
            <span class="text-2xl text-cyan-300" aria-hidden="true">
              01.
            </span>
            <p class="mt-4 leading-7">
              Connect with ECWA scholars across universities, seminaries,
              colleges of education, and polytechnics.
            </p>
          </div>
          <div
            class="p-6 bg-[#042F3A] text-base leading-relaxed text-white"
            style="background-image:
      repeating-linear-gradient(0deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      repeating-linear-gradient(90deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      radial-gradient(at 20% 20%, rgba(6,182,212,0.35) 0, transparent 50%),
      radial-gradient(at 80% 15%, rgba(34,211,238,0.25) 0, transparent 45%),
      radial-gradient(at 70% 85%, rgba(8,145,178,0.3) 0, transparent 50%),
      radial-gradient(at 10% 90%, rgba(103,232,249,0.2) 0, transparent 45%);"
          >
            <span class="text-2xl text-cyan-300" aria-hidden="true">
              02.
            </span>
            <p class="mt-4 leading-7">
              Participate in conferences, seminars, workshops, retreats, and
              research activities.
            </p>
          </div>
          <div
            class="p-6 bg-[#042F3A] text-base leading-relaxed text-white"
            style="background-image:
      repeating-linear-gradient(0deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      repeating-linear-gradient(90deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      radial-gradient(at 20% 20%, rgba(6,182,212,0.35) 0, transparent 50%),
      radial-gradient(at 80% 15%, rgba(34,211,238,0.25) 0, transparent 45%),
      radial-gradient(at 70% 85%, rgba(8,145,178,0.3) 0, transparent 50%),
      radial-gradient(at 10% 90%, rgba(103,232,249,0.2) 0, transparent 45%);"
          >
            <span class="text-2xl text-cyan-300" aria-hidden="true">
              03.
            </span>
            <p class="mt-4 leading-7">
              Contribute to scholarly publications and the ECWA Scholars
              Journal.
            </p>
          </div>
          <div
            class="p-6 bg-[#042F3A] text-base leading-relaxed text-white"
            style="background-image:
      repeating-linear-gradient(0deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      repeating-linear-gradient(90deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      radial-gradient(at 20% 20%, rgba(6,182,212,0.35) 0, transparent 50%),
      radial-gradient(at 80% 15%, rgba(34,211,238,0.25) 0, transparent 45%),
      radial-gradient(at 70% 85%, rgba(8,145,178,0.3) 0, transparent 50%),
      radial-gradient(at 10% 90%, rgba(103,232,249,0.2) 0, transparent 45%);"
          >
            <span class="text-2xl text-cyan-300" aria-hidden="true">
              04.
            </span>
            <p class="mt-4 leading-7">
              Collaborate on research and consultancy initiatives.
            </p>
          </div>
          <div
            class="p-6 bg-[#042F3A] text-base leading-relaxed text-white"
            style="background-image:
      repeating-linear-gradient(0deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      repeating-linear-gradient(90deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      radial-gradient(at 20% 20%, rgba(6,182,212,0.35) 0, transparent 50%),
      radial-gradient(at 80% 15%, rgba(34,211,238,0.25) 0, transparent 45%),
      radial-gradient(at 70% 85%, rgba(8,145,178,0.3) 0, transparent 50%),
      radial-gradient(at 10% 90%, rgba(103,232,249,0.2) 0, transparent 45%);"
          >
            <span class="text-2xl text-cyan-300" aria-hidden="true">
              05.
            </span>
            <p class="mt-4 leading-7">
              Support communities and contribute to the mission of ECWA.
            </p>
          </div>
          <div
            class="p-6 bg-[#042F3A] text-base leading-relaxed text-white"
            style="background-image:
      repeating-linear-gradient(0deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      repeating-linear-gradient(90deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      radial-gradient(at 20% 20%, rgba(6,182,212,0.35) 0, transparent 50%),
      radial-gradient(at 80% 15%, rgba(34,211,238,0.25) 0, transparent 45%),
      radial-gradient(at 70% 85%, rgba(8,145,178,0.3) 0, transparent 50%),
      radial-gradient(at 10% 90%, rgba(103,232,249,0.2) 0, transparent 45%);"
          >
            <span class="text-2xl text-cyan-300" aria-hidden="true">
              06.
            </span>
            <p class="mt-4 leading-7">
              Build national and international professional and academic
              networks.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Commitment and registration -->
    <section class="py-10 lg:py-20">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="grid gap-8 lg:grid-cols-2">
          <div>
            <div class="relative isolate overflow-hidden rounded-lg border bg-[#06005A] p-5 sm:p-8">
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 opacity-20"
                style="background-image:
              repeating-linear-gradient(45deg, transparent 0 25px, rgba(255,255,255,.288) 25px 26px),
              repeating-linear-gradient(-45deg, transparent 0 38px, rgba(255,255,255,.288) 38px 39px);"
              ></div>
              <div class="rounded-2xl text-white sm:p-9">
                <p class="text-lg font-bold tracking-wider text-cyan-300">
                  Membership commitment
                </p>
                <h2 class="mt-3 text-2xl font-bold">
                  Stay active in the Society
                </h2>
                <p class="mt-5 leading-7 text-slate-300">
                  Members are encouraged to demonstrate commitment to the
                  Society by formally registering with ESS. Existing members are
                  also encouraged to fulfil their obligations through annual
                  membership renewal.
                </p>
              </div>
            </div>
          </div>

          <div class="border-4 border-cyan-800 p-5 shadow-lg">
            <p class="text-lg font-bold tracking-wider text-[#06005A]">
              Registration and renewal
            </p>
            <h2 class="mt-3 text-2xl font-bold text-slate-900">
              Membership fee: ₦10,000
            </h2>
            <p class="mt-3 leading-7 text-slate-600">
              Both new membership registration and annual renewal attract a fee
              of ₦10,000. Payments should be made to the Conference account
              below.
            </p>

            <dl class="mt-6 divide-y divide-slate-200 rounded-xl border border-slate-200">
              <div class="flex justify-between gap-4 px-4 py-3">
                <dt class="text-slate-500">Bank</dt>
                <dd class="text-right font-medium text-slate-900">
                  Gowans Microfinance Bank
                </dd>
              </div>
              <div class="flex justify-between gap-4 px-4 py-3">
                <dt class="text-slate-500">Account type</dt>
                <dd class="text-right font-medium text-slate-900">Savings</dd>
              </div>
              <div class="flex justify-between gap-4 px-4 py-3">
                <dt class="text-slate-500">Account number</dt>
                <dd class="text-right font-semibold tracking-wide text-slate-900">
                  1100187704
                </dd>
              </div>
              <div class="flex justify-between gap-4 px-4 py-3">
                <dt class="text-slate-500">Account name</dt>
                <dd class="text-right font-medium text-slate-900">
                  ECWA Scholars Conference
                </dd>
              </div>
            </dl>

            <p class="mt-5 text-sm leading-6 text-slate-500">
              After payment, send your payment evidence to the Secretariat
              Secretary to complete the required registration or renewal
              process:{" "}
              <a
                href="http://wa.me/2348066259948"
                class="font-bold text-cyan-800 hover:opacity-60"
              >
                Secretariat Secretary↗
              </a>
              .
            </p>
          </div>
        </div>
      </div>
    </section>

    <!--  -->
  </div>
  <Footer />
</Layout>
