---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import annualConf1 from "../assets/image-1.jpeg";
import president from "../assets/Professor-Abbas-Magaji-Ahuwan.jpg";
import vicePresident from "../assets/Rev-Prof-Laazarus-b-tekdek.jpg";
import secretary from "../assets/Rev-Prof-Sunday-Bobai-Agang-PhD.jpg";
import assistSecretary from "../assets/Prof-Mariam-Danladi-Solomon.jpg";
import secSecretary from "../assets/Pst-Samson-Musa.jpg";
import treasurer from "../assets/Dr-Mrs-Hauwa-B-K-Bala.jpg";
import pro from "../assets/Rev-Assoc-Prof-Reuben-Goje-Maiture.jpg";
import finSec from "../assets/Professor-Nuhu-Dogara-Gado.jpg";
---

<Layout title="About | ECWA Society for Scholars">
  <Header />
  <div class="plus-jakarta-sans-normal">
    <div class="bg-[#faf5ee] py-5 lg:py-10">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="text-xs space-x-2">
          <a href="/" class="text-[#06005A] hover:opacity-60">
            Home
          </a>
          <span>/</span>
          <span class="text-black">About</span>
        </div>
        <h2 class="font-bold text-xl lg:text-3xl mt-2 libre-baskerville-bold">
          ECWA Society for Scholars (ESS)
        </h2>
      </div>
    </div>

    <section>
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="text-base lg:text-lg py-10 lg:py-20 text-slate-600 lg:w-8/12">
          The ECWA Society for Scholars (ESS) is a scholarly platform
          established to bring together academics from Evangelical Church
          Winning All (ECWA) extraction for intellectual engagement, research,
          collaboration, and service to the Church and society.
        </div>
      </div>
    </section>

    <section>
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-20 pb-20">
          <div>
            <div class="border-4 border-cyan-800 p-5 shadow-lg">
              <h2 class="font-bold text-cyan-800">At a Glance</h2>
              <div class="my-6 space-y-6 text-xs">
                <div class="flex justify-between">
                  <b>Conceived</b>
                  <span class="text-black">2012</span>
                </div>
                <div class="flex justify-between border-y border-cyan-800 py-6">
                  <b>Inaugurated</b>
                  <span class="text-black">27 Nov 2018</span>
                </div>
                <div class="flex justify-between">
                  <b>Institutions</b>
                  <span class="text-black">10+ across Nigeria</span>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:col-span-2">
            <h2 class="text-lg font-bold tracking-wider text-[#06005A]">
              History
            </h2>
            <div class="mt-2 lg:mt-5 space-y-4 text-sm lg:text-base leading-relaxed">
              <p>
                The Idea for the Society was conceived in 2012 as a forum
                through which university, theological seminary, college of
                education, and polytechnic scholars could come together as a
                think tank to undertake research and offer informed perspectives
                on issues affecting ECWA, the wider Christian community, and
                Nigerian society.
              </p>
              <p>
                Following broad consultations with ECWA leaders, senior scholars
                and heads of ECWA institutions, the vision was endorsed as a
                timely contribution to the Church's intellectual life and its
                engagement with national development.
              </p>
              <p>
                Formally inaugurated on 27 November 2018 by the ECWA President,
                Rev. (Dr.) Stephen B. Panya, at the 1st ESS Summit. The
                inaugural Summit brought together 60 participants from more than
                ten institutions of higher learning across Nigeria, marking the
                beginning of a sustained scholarly community committed to faith,
                truth and service.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="bg-[#042F3A] px-6 py-10 lg:py-20 text-base leading-relaxed text-white"
      style="background-image:
      repeating-linear-gradient(0deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      repeating-linear-gradient(90deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      radial-gradient(at 20% 20%, rgba(6,182,212,0.35) 0, transparent 50%),
      radial-gradient(at 80% 15%, rgba(34,211,238,0.25) 0, transparent 45%),
      radial-gradient(at 70% 85%, rgba(8,145,178,0.3) 0, transparent 50%),
      radial-gradient(at 10% 90%, rgba(103,232,249,0.2) 0, transparent 45%);"
    >
      <div class="lg:w-1/3 mx-auto text-center">
        <div class="bg-white h-px w-1/12 mx-auto mb-8"></div>
        <h2 class="text-lg font-bold tracking-wider text-cyan-300">
          Our Motto
        </h2>
        <h1 class="font-bold text-2xl lg:text-4xl mt-6">Unity in Truth</h1>
      </div>
    </section>

    <section>
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="py-10 lg:py-20 grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20">
          <div>
            <h2 class="text-lg font-bold tracking-wider text-[#06005A]">
              Vision
            </h2>
            <div class="mt-2 lg:mt-5 text-base leading-relaxed">
              ESS seeks to bear witness to the Truth (John 18:37), grow in
              Christian maturity (Romans 10:13; James 2:14), and remain united
              and empowered by the Truth. The Society contributes
              philosophically to the global ministry of ECWA.
            </div>
          </div>
          <div>
            <h2 class="text-lg font-bold tracking-wider text-[#06005A]">
              Mission
            </h2>
            <div class="mt-2 lg:mt-5 text-base leading-relaxed">
              The Society exists to promote truth, unity, friendship, and
              collaboration among ECWA scholars through result-oriented
              research. It engages spiritual, technological, scientific, and
              philosophical ideas that are useful to communities, especially
              institutions of higher learning, through curriculum development,
              seminars, conferences, and publications including the ECWA
              Scholars Journal.
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-16 sm:px-8">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="mb-8">
          <p class="text-lg font-bold tracking-wider text-[#06005A]">
            Our core values
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-4xl">
            What guides us
          </h2>
        </div>

        <div
          class="bg-[#042F3A] text-base leading-relaxed text-white"
          style="background-image:
      repeating-linear-gradient(0deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      repeating-linear-gradient(90deg, transparent 0 1px, rgba(0,20,28,0.25) 1px 2px),
      radial-gradient(at 20% 20%, rgba(6,182,212,0.35) 0, transparent 50%),
      radial-gradient(at 80% 15%, rgba(34,211,238,0.25) 0, transparent 45%),
      radial-gradient(at 70% 85%, rgba(8,145,178,0.3) 0, transparent 50%),
      radial-gradient(at 10% 90%, rgba(103,232,249,0.2) 0, transparent 45%);"
        >
          <div class="grid grid-cols-2 gap-px overflow-hidden sm:grid-cols-3 lg:grid-cols-5">
            <div class="min-h-28 bg-cyan-950/70 p-5 transition">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
                01.
              </span>
              <p class="mt-3 font-medium text-white">Christ-likeness</p>
            </div>

            <div class="min-h-28 bg-cyan-950/70 p-5 transition">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
                02.
              </span>
              <p class="mt-3 font-medium text-white">Love</p>
            </div>

            <div class="min-h-28 bg-cyan-950/70 p-5 transition">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
                03.
              </span>
              <p class="mt-3 font-medium text-white">Truth</p>
            </div>

            <div class="min-h-28 bg-cyan-950/70 p-5 transition">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
                04.
              </span>
              <p class="mt-3 font-medium text-white">Faith</p>
            </div>

            <div class="min-h-28 bg-cyan-950/70 p-5 transition">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
                05.
              </span>
              <p class="mt-3 font-medium text-white">Prayer</p>
            </div>

            <div class="min-h-28 bg-cyan-950/70 p-5 transition">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
                06.
              </span>
              <p class="mt-3 font-medium text-white">Integrity</p>
            </div>

            <div class="min-h-28 bg-cyan-950/70 p-5 transition">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
                07.
              </span>
              <p class="mt-3 font-medium text-white">Honesty</p>
            </div>

            <div class="min-h-28 bg-cyan-950/70 p-5 transition">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
                08.
              </span>
              <p class="mt-3 font-medium text-white">Scholarly competence</p>
            </div>

            <div class="col-span-2 min-h-28 bg-cyan-950/70 p-5 transition sm:col-span-2 lg:col-span-2">
              <span class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
                09.
              </span>
              <p class="mt-3 font-medium leading-6 text-white">
                Confidence in ECWA institutions and establishments
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-10 lg:py-20">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <h2 class="text-lg font-bold tracking-wider text-[#06005A]">
          What we do
        </h2>
        <div class="mt-2 lg:mt-5 space-y-5 text-base leading-relaxed">
          <p>
            ESS promotes unity and provides encouragement and support for
            scholars in their areas of specialization. It encourages scholars to
            see themselves as partners with ECWA, support their communities, and
            appreciate the activities of the Church. The Society also builds
            national and international connections among ECWA members and
            affiliated organizations with similar aims.
          </p>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 py-5 lg:py-10">
            <div>
              <Image
                src={annualConf1}
                alt="What we do at ESS"
                class="h-full w-full rounded-2xl object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              />
            </div>
            <div>
              <ul class="space-y-5">
                <li class="flex items-start gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-sm font-bold text-cyan-700">
                    01
                  </span>
                  <p class="pt-0.5 leading-7">
                    Conferences, seminars, workshops and retreats fostering
                    theological and academic dialogue.
                  </p>
                </li>

                <li class="flex items-start gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-sm font-bold text-cyan-700">
                    02
                  </span>
                  <p class="pt-0.5 leading-7">
                    Research, consultancies and entrepreneurship initiatives
                    serving ECWA and society.
                  </p>
                </li>

                <li class="flex items-start gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-sm font-bold text-cyan-700">
                    03
                  </span>
                  <p class="pt-0.5 leading-7">
                    Scholarly publications, including the ECWA Scholars Journal
                    and policy briefs.
                  </p>
                </li>

                <li class="flex items-start gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-sm font-bold text-cyan-700">
                    04
                  </span>
                  <p class="pt-0.5 leading-7">
                    Curriculum development and mentorship for emerging scholars.
                  </p>
                </li>

                <li class="flex items-start gap-4">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cyan-100 text-sm font-bold text-cyan-700">
                    05
                  </span>
                  <p class="pt-0.5 leading-7">
                    Building national and international connections with aligned
                    networks and institutions.
                  </p>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pb-20 plus-jakarta-sans-normal">
      <div class="w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
        <div class="relative isolate overflow-hidden rounded-lg border border-white/15 bg-[#06005A] p-5 sm:p-8">
          <!-- Subtle crosshatch -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 opacity-20"
            style="background-image:
              repeating-linear-gradient(45deg, transparent 0 25px, rgba(255,255,255,.288) 25px 26px),
              repeating-linear-gradient(-45deg, transparent 0 38px, rgba(255,255,255,.288) 38px 39px);"
          ></div>

          <div>
            <h2 class="text-3xl text-cyan-100 font-bold">The Team</h2>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-20 py-5 lg:py-10">
              <div class="group space-y-2 text-center">
                <div class="overflow-hidden rounded">
                  <Image
                    src={president}
                    alt="Portrait of Prof. Abbas Magaji Ahuwan"
                    class="h-full w-full object-cover object-center grayscale transition-transform duration-300 ease-in-out group-hover:scale-110 group-hover:grayscale-0"
                  />
                </div>

                <h2 class="text-sm lg:text-base font-bold leading-tight text-cyan-100">
                  Prof. Abbas Magaji Ahuwan
                </h2>
                <h3 class="text-xs lg:text-sm text-cyan-600">ESS President</h3>
              </div>
              <div class="group space-y-2 text-center">
                <div class="overflow-hidden rounded">
                  <Image
                    src={vicePresident}
                    alt="Portrait of Rev. Prof. La'azarus B. Tekdek"
                    class="h-full w-full object-cover object-center grayscale transition-transform duration-300 ease-in-out group-hover:scale-110 group-hover:grayscale-0"
                  />
                </div>

                <h2 class="text-sm lg:text-base font-bold leading-tight text-cyan-100">
                  Rev. Prof. La'azarus B. Tekdek
                </h2>
                <h3 class="text-xs lg:text-sm text-cyan-600">ESS Vice President</h3>
              </div>
              <div class="group space-y-2 text-center">
                <div class="overflow-hidden rounded">
                  <Image
                    src={secretary}
                    alt="Portrait of Rev. Prof. Sunday Bobai Agang, PhD"
                    class="h-full w-full object-cover object-center grayscale transition-transform duration-300 ease-in-out group-hover:scale-110 group-hover:grayscale-0"
                  />
                </div>

                <h2 class="text-sm lg:text-base font-bold leading-tight text-cyan-100">
                  Rev. Prof. Sunday Bobai Agang, PhD
                </h2>
                <h3 class="text-xs lg:text-sm text-cyan-600">ESS Secretary</h3>
              </div>
              <div class="group space-y-2 text-center">
                <div class="overflow-hidden rounded">
                  <Image
                    src={assistSecretary}
                    alt="Portrait of Prof. Mariam Danladi Solomon"
                    class="h-full w-full object-cover object-center grayscale transition-transform duration-300 ease-in-out group-hover:scale-110 group-hover:grayscale-0"
                  />
                </div>

                <h2 class="text-sm lg:text-base font-bold leading-tight text-cyan-100">
                  Prof. Mariam Danladi Solomon
                </h2>
                <h3 class="text-xs lg:text-sm text-cyan-600">ESS Assist. Secretary</h3>
              </div>
              <div class="group space-y-2 text-center">
                <div class="overflow-hidden rounded">
                  <Image
                    src={treasurer}
                    alt="Portrait of Dr. Mrs. Hauwa B. K. Bala"
                    class="h-full w-full object-cover object-center grayscale transition-transform duration-300 ease-in-out group-hover:scale-110 group-hover:grayscale-0"
                  />
                </div>

                <h2 class="text-sm lg:text-base font-bold leading-tight text-cyan-100">
                  Dr. Mrs. Hauwa B. K. Bala
                </h2>
                <h3 class="text-xs lg:text-sm text-cyan-600">ESS Treasurer</h3>
              </div>
              <div class="group space-y-2 text-center">
                <div class="overflow-hidden rounded">
                  <Image
                    src={finSec}
                    alt="Portrait of Professor Nuhu Dogara Gado"
                    class="h-full w-full object-cover object-center grayscale transition-transform duration-300 ease-in-out group-hover:scale-110 group-hover:grayscale-0"
                  />
                </div>

                <h2 class="text-sm lg:text-base font-bold leading-tight text-cyan-100">
                  Prof. Nuhu Dogara Gado, Ph.D., MNIM, MESS, FIMBLN, FIPMN
                </h2>
                <h3 class="text-xs lg:text-sm text-cyan-600">ESS Financial Secretary</h3>
              </div>
              <div class="group space-y-2 text-center">
                <div class="overflow-hidden rounded">
                  <Image
                    src={pro}
                    alt="Portrait of Rev. Assoc. Prof. Reuben Goje Maiture"
                    class="h-full w-full object-cover object-center grayscale transition-transform duration-300 ease-in-out group-hover:scale-110 group-hover:grayscale-0"
                  />
                </div>

                <h2 class="text-sm lg:text-base font-bold leading-tight text-cyan-100">
                  Rev. Assoc. Prof. Reuben Goje Maiture
                </h2>
                <h3 class="text-xs lg:text-sm text-cyan-600">
                  ESS Public Relations Officer
                </h3>
              </div>
              <div class="group space-y-2 text-center">
                <div class="overflow-hidden rounded">
                  <Image
                    src={secSecretary}
                    alt="Portrait of Pst. Samson Musa"
                    class="h-full w-full object-cover object-center grayscale transition-transform duration-300 ease-in-out group-hover:scale-110 group-hover:grayscale-0"
                  />
                </div>

                <h2 class="text-sm lg:text-base font-bold leading-tight text-cyan-100">
                  Pst. Samson Musa
                </h2>
                <h3 class="text-xs lg:text-sm text-cyan-600">ESS Secretariat Secretary</h3>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!--  -->
  </div>
  <Footer />
</Layout>
