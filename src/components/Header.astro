---
import { Image } from "astro:assets";
import logo from "../assets/ECWA-Society-for-Scholars.jpg";
import facebook from "../assets/facebook.svg";
import MenuList from "./MenuList.astro";

const { title = "ECWA Society for Scholars" } = Astro.props;
---

<script>
  const openButton = document.querySelector<HTMLButtonElement>("#mobile-btn");
  const closeButton =
    document.querySelector<HTMLButtonElement>("#close-mobile-btn");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const backdrop = document.querySelector<HTMLElement>("#mobile-backdrop");

  function setMenuOpen(isOpen: boolean) {
    if (!menu || !openButton) return;

    menu.classList.toggle("hidden", !isOpen);
    openButton.setAttribute("aria-expanded", String(isOpen));
    document.body.classList.toggle("overflow-hidden", isOpen);
  }

  openButton?.addEventListener("click", () => {
    const isOpen = openButton.getAttribute("aria-expanded") === "true";
    setMenuOpen(!isOpen);
  });

  closeButton?.addEventListener("click", () => {
    setMenuOpen(false);
  });

  backdrop?.addEventListener("click", () => {
    setMenuOpen(false);
  });

  menu?.addEventListener("click", (event) => {
    const target = event.target;

    if (target instanceof Element && target.closest("a")) {
      setMenuOpen(false);
    }
  });

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      openButton?.getAttribute("aria-expanded") === "true"
    ) {
      setMenuOpen(false);
      openButton.focus();
    }
  });
</script>

<header class="plus-jakarta-sans-normal shadow-md">
  <div class="mx-auto w-full max-w-full px-4 sm:px-6 md:px-8 lg:max-w-5xl xl:max-w-6xl 2xl:max-w-7xl">
    <div class="flex justify-between py-3">
      <a href="/" aria-label={`${title} home`}>
        <Image
          src={logo}
          alt="ECWA Society for Scholars logo"
          class="w-16 lg:w-25"
        />
      </a>

      <!-- Mobile menu overlay -->
      <div id="mobile-menu" class="hidden">
        <div
          class="fixed inset-0 z-50 flex h-screen w-full"
          role="dialog"
          aria-modal="true"
          aria-label="Mobile navigation"
        >
          <button
            id="mobile-backdrop"
            type="button"
            class="grow cursor-default bg-black/70"
            aria-label="Close navigation menu"
          ></button>

          <div class="h-full w-60 max-w-[65vw] overflow-y-auto bg-white">
            <div class="flex justify-between border-b border-[#06005A] px-3 py-2">
              <span class="sr-only">Navigation</span>

              <button
                id="close-mobile-btn"
                type="button"
                class="rounded p-1 hover:opacity-60 focus-visible:outline-2 -ml-3 text-slate-600 cursor-pointer"
                aria-label="Close menu"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="size-8"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 18 18 6M6 6l12 12"
                  />
                </svg>
              </button>
            </div>

            <nav aria-label="Mobile navigation links">
              <MenuList textColor="text-black" />
            </nav>
          </div>
        </div>
      </div>

      <!-- Mobile menu toggle -->
      <div class="w-fit lg:hidden">
        <button
          id="mobile-btn"
          type="button"
          class="cursor-pointer hover:opacity-60"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-10"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25"
            />
          </svg>
        </button>
      </div>

      <!-- Desktop navigation -->
      <MenuList textColor="hidden lg:flex text-black" />

      <div class="hidden items-center lg:flex">
        <a
          href="https://www.facebook.com/profile.php?id=61596566111886"
          class="hover:grayscale"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="ECWA Society for Scholars on Facebook"
        >
          <Image src={facebook} alt="" class="w-6" />
        </a>
      </div>
    </div>
  </div>
</header>
